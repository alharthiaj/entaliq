# رابط قاعدة البيانات PostgreSQL (من Neon أو Supabase أو استضافتك)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# مفتاح سري طويل وعشوائي لتأمين جلسات لوحة التحكم (٣٢ حرفًا على الأقل)
AUTH_SECRET="ضع-هنا-نصًا-عشوائيًا-طويلًا"
# رابط موقعك النهائي
SITE_URL="https://www.example.com"
# بيانات أول مدير (تُستخدم مرة واحدة عند التهيئة)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="غيّرها-فورًا"
# مفاتيح بوابة الدفع ميسّر (من لوحة ميسّر). اتركها فارغة لإخفاء الدفع بالبطاقة
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
